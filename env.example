# OKX API 配置模板
# 复制此文件为 .env 并填入你的API密钥
# cp env.example .env

# API密钥 (从OKX获取: https://www.okx.com/account/my-api)
EXCHANGE_API_KEY=your-api-key-here
EXCHANGE_SECRET=your-secret-key-here
EXCHANGE_PASSWORD=your-passphrase-here

# 代理设置 (如果需要翻墙)
PROXY_ENABLED=true
HTTP_PROXY=http://127.0.0.1:7890
HTTPS_PROXY=http://127.0.0.1:7890

